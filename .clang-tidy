---
# BitCal clang-tidy Configuration
# Optimized for header-only SIMD library with minimal noise
#
# Philosophy: Keep warnings that catch real bugs, suppress SIMD-incompatible rules
#
# Categories of suppressed checks:
# - SIMD-incompatible: pointer-arithmetic, reinterpret-cast, array-decay
# - Style preferences: magic-numbers, identifier-length, naming
# - False positives for templates: chained-comparison, member-init
# - Low-value noise: c-arrays, enum-size, macro-to-enum
Checks: >
  -*,
  performance-*,
  -performance-enum-size,
  portability-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-chained-comparison,
  cert-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-special-member-functions,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-macro-to-enum,
  -modernize-use-using,
  -modernize-concat-nested-namespaces,
  -modernize-avoid-c-arrays,
  readability-*,
  -readability-named-parameter,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-simplify-boolean-expr,
  -readability-use-anyofallof,
  -readability-identifier-naming,
  -readability-math-missing-parentheses,
  clang-analyzer-*

WarningsAsErrors: ''

HeaderFilterRegex: 'include/bitcal/.*'

CheckOptions:
  - key:   performance-for-range-copy.WarnOnAllAutoCopies
    value: 'true'
  - key:   bugprone-argument-comment.StrictMode
    value: '1'
