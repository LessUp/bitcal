// backend_ops.def - BitCal Backend Operations Definition
//
// ============================================================================
// 这个文件定义了所有后端操作的标准接口
// ============================================================================
//
// 使用方法：
// 1. 定义 BITCAL_OP 宏来生成代码
// 2. 包含此文件
// 3. 取消定义 BITCAL_OP 宏
//
// 示例：
// #define BITCAL_OP(name, params) \
//     static void name params noexcept { impl::name(params); }
// #include "backend_ops.def"
// #undef BITCAL_OP
//
// ============================================================================

// ============================================================================
// 位运算操作（Bitwise Operations）
// ============================================================================
// 这些操作对所有后端都相同，只是调用不同的底层实现

#define BITCAL_BIT_OPS \
    BITCAL_OP(bit_and,    (const uint64_t* a, const uint64_t* b, uint64_t* out)) \
    BITCAL_OP(bit_or,     (const uint64_t* a, const uint64_t* b, uint64_t* out)) \
    BITCAL_OP(bit_xor,    (const uint64_t* a, const uint64_t* b, uint64_t* out)) \
    BITCAL_OP(bit_not,    (const uint64_t* in, uint64_t* out)) \
    BITCAL_OP(bit_andnot, (const uint64_t* a, const uint64_t* b, uint64_t* out))

// ============================================================================
// 移位操作（Shift Operations）
// ============================================================================
// 左移和右移操作，支持任意位移量

#define BITCAL_SHIFT_OPS \
    BITCAL_OP(shift_left,  (uint64_t* data, int count)) \
    BITCAL_OP(shift_right, (uint64_t* data, int count))

// ============================================================================
// 查询操作（Query Operations）
// ============================================================================
// 检查位数组状态的谓词操作

#define BITCAL_QUERY_OPS \
    BITCAL_OP(is_zero,  (const uint64_t* data)) \
    BITCAL_OP(all,      (const uint64_t* data)) \
    BITCAL_OP(equals,   (const uint64_t* a, const uint64_t* b))

// ============================================================================
// 计数操作（Count Operations）
// ============================================================================
// popcount：统计 1 的个数
// count_leading_zeros：统计前导零个数
// count_trailing_zeros：统计尾部零个数

#define BITCAL_COUNT_OPS \
    BITCAL_OP(popcount, (const uint64_t* data)) \
    BITCAL_OP(count_leading_zeros, (const uint64_t* data)) \
    BITCAL_OP(count_trailing_zeros, (const uint64_t* data))

// ============================================================================
// 所有操作（All Operations）
// ============================================================================
// 包含上述所有操作，用于批量生成

#define BITCAL_ALL_OPS \
    BITCAL_BIT_OPS \
    BITCAL_SHIFT_OPS \
    BITCAL_QUERY_OPS \
    BITCAL_COUNT_OPS
